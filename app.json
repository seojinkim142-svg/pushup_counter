{
  "expo": {
    "name": "FreeFit",
    "slug": "push_up_counter",
    "owner": "tjwls2123",
    "scheme": "pushupcounter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freefit.pushupcounter",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME)이(가) 푸시업 개수를 세기 위해 카메라를 사용합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.freefit.pushupcounter"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME)이(가) 푸시업 개수를 세기 위해 카메라를 사용합니다.",
          "enableCodeScanner": false
        }
      ],
      "./plugins/withMediaPipeModel.js",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "535e0b91-fbee-4644-bbda-9606c21586fe"
      }
    }
  }
}
